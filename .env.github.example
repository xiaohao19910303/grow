# Standalone web deployment. Copy to .env; never commit actual credentials.
DATABASE_URL=postgresql://grow_user:CHANGE_ME@127.0.0.1:5432/grow
APP_USERNAME=owner
APP_PASSWORD=REPLACE_WITH_AT_LEAST_24_RANDOM_CHARACTERS
# Generate once, keep separately from backups; losing this key loses saved token access.
ACCOUNT_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
PLAN_CONTENT_BACKEND=github
GITHUB_CONTENT_REPO=your-account/your-private-content-repo
GITHUB_CONTENT_BRANCH=main
GITHUB_CONTENT_TOKEN=
# Absolute directories owned by the service user; runtime is not a database backup.
RUNTIME_ROOT=/var/lib/grow/runtime
# Export with prepare_materials.py first; do not use an old personal materials root.
LEARN_ROOT=REPLACE_WITH_ABSOLUTE_PREPARED_MATERIALS_DIRECTORY
CLOUD_DEPLOY=0
PORT=8756
# No App/Zook/bridge configuration is required.
GROW_SCHEDULED_READING_ENABLED=0
# Optional public origin for scheduled reading wakeup and bound mobile plan progress.
# Standalone H5 does not require it. See docs/grow-mobile-execution.md and docs/deployment/standalone-web.md.
GROW_PUBLIC_URL=
GROW_SCHEDULE_REPOSITORY=
GROW_SCHEDULE_REPOSITORY_ID=
GROW_SCHEDULE_REF=refs/heads/main
