# Copy values into Render Environment; do not commit actual credentials.
PLAN_CONTENT_BACKEND=github
GITHUB_CONTENT_REPO=xiaohao19910303/zhixing
GITHUB_CONTENT_BRANCH=main
GITHUB_CONTENT_TOKEN=
